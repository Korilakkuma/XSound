{
  "extends": [
    "markuplint:recommended"
  ],
  "excludeFiles": [
    "docs/**/*.html",
    "playground/**/*.html"
  ],
  "nodeRules": [
    {
      "selector": "html",
      "rules": {
        "no-unknown-attr": {
          "options": {
            "allowAttrs": ["prefix"]
          }
        }
      }
    }
  ]
}
